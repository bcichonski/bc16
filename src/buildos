#!/bin/bash
# Pick the Python interpreter: winpty python on Git Bash (Windows), else python3, else python.
if command -v winpty >/dev/null 2>&1; then
    PY="winpty python"
elif command -v python3 >/dev/null 2>&1; then
    PY="python3"
else
    PY="python"
fi
trap "exit 1" TERM
export TOP_PID=$$

check_exit_code()
{
    if [ $1 -ne 0 ]; then
        echo "Error"
        kill -s TERM $TOP_PID
    fi
}

echo building bcos...
$PY ./bc81asmc/bc81asmc.py --verbose ./bc81asmc/bcOS/bcos.basm
check_exit_code $?

echo converting bcos to rom...
./ftool btap2bin bc81asmc/bcOS/bcos.btap bc81asmc/bcOS/bcos_v1_2_0.b81
check_exit_code $?

echo building bootloader...
$PY ./bc81asmc/bc81asmc.py --verbose ./bdos/boot.basm
check_exit_code $?

echo building bdos...
./bcc ./bdos/bdos
check_exit_code $?

echo done!